"""
Signal two: the style signal. — Milestone 4 implementation

Signal one reads the text for meaning. This one measures it as text — the
shape of it, without understanding a word.

Three measures are implemented below:
    sentence_length_spread   do sentences vary in length, or march in step?
    type_token_ratio         how much of the vocabulary repeats?
    punctuation_density      how much punctuation, and how varied?
"""

import re
import statistics


def sentences(text: str) -> list[str]:
    """Split into sentences. Rough and good enough — given to you."""
    parts = re.split(r"(?<=[.!?])\s+", text.strip())
    return [p for p in parts if p.strip()]


def words(text: str) -> list[str]:
    """Split into lowercase words, punctuation stripped. Given to you."""
    return re.findall(r"[a-z0-9']+", text.lower())


# ── The three measures ─────────────────────────────────────────────────────

def sentence_length_spread(text: str) -> float:
    """
    How much sentence length varies.
    Returns the coefficient of variation (stdev / mean) of sentence word counts.
    Handles edge cases like 0 or 1 sentence gracefully.
    """
    s_list = sentences(text)
    if len(s_list) <= 1:
        return 0.0
    
    lengths = [len(words(s)) for s in s_list]
    mean_len = statistics.mean(lengths)
    if mean_len == 0:
        return 0.0
    
    # If all sentences have the same length, stdev is 0
    if len(lengths) < 2:
        return 0.0
        
    try:
        stdev_len = statistics.stdev(lengths)
        return stdev_len / mean_len
    except statistics.StatisticsError:
        return 0.0


def type_token_ratio(text: str) -> float:
    """
    Unique words over total words (Vocabulary richness).
    Returns a float between 0 and 1.
    """
    w_list = words(text)
    if not w_list:
        return 0.0
    return len(set(w_list)) / len(w_list)


def punctuation_density(text: str) -> float:
    """
    How much punctuation relative to total characters.
    Counts structural punctuation marks (commas, semicolons, dashes, colons).
    """
    if not text.strip():
        return 0.0
    # Count commas, semicolons, colons, em-dashes, en-dashes, question/exclamation marks
    punct_chars = re.findall(r"[,;:\-?!]", text)
    return len(punct_chars) / len(text)


# ── Combining them ───────────────────────────────────────────────────────────

def style_signal(text: str) -> float:
    """
    The style signal as a 0–1 score. **Higher means more likely AI.**
    
    AI writing tends to have:
      - Lower sentence length spread (uniform length sentences -> higher AI score after inversion)
      - Lower type-token ratio (repetitive vocabulary range -> higher AI score after inversion)
      - Moderate or rigid punctuation density
    """
    s_spread = sentence_length_spread(text)
    ttr = type_token_ratio(text)
    p_density = punctuation_density(text)

    # 1. Sentence length spread: humans usually have higher spread (>0.5), AI lower (<0.3).
    # Invert so lower spread maps closer to 1.0 (AI-ish). Cap at 1.0.
    spread_ai_score = max(0.0, min(1.0, 1.0 - (s_spread * 1.5)))

    # 2. Type-token ratio: AI tends to have narrower vocabulary on fixed lengths (~0.4 - 0.6).
    # Map a lower TTR to a higher AI score.
    ttr_ai_score = max(0.0, min(1.0, 1.2 - (ttr * 1.2)))

    # 3. Punctuation density: Normalization baseline around 0.02 - 0.05
    p_score = max(0.0, min(1.0, p_density * 20.0))

    # Weighted blend of the stylistic factors
    combined = (spread_ai_score * 0.45) + (ttr_ai_score * 0.45) + (p_score * 0.10)
    return round(max(0.0, min(1.0, combined)), 4)


if __name__ == "__main__":
    import sys

    text = " ".join(sys.argv[1:]) or (
        "The system works well. It handles most cases correctly and provides "
        "good results. Users generally find it easy to use and understand."
    )

    print(f"{len(sentences(text))} sentences, {len(words(text))} words\n")
    print(f"sentence_length_spread   {sentence_length_spread(text)}")
    print(f"type_token_ratio         {type_token_ratio(text)}")
    print(f"punctuation_density      {punctuation_density(text)}")
    print(f"style_signal             {style_signal(text)}   (higher = more likely AI)")
